{
  // zeroness Egress Worker — the enforcement data plane.
  "name": "zeroness-egress",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Bind the same ZeronessBroker DO the control plane uses.
  "durable_objects": {
    "bindings": [{ "name": "ZERONESS_BROKER", "class_name": "ZeronessBroker", "script_name": "zeroness-broker" }]
  },
  // Capture this Worker's own logs too (audit is emitted by the Broker). See
  // docs/logging.md for Workers Logs + Logpush.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
