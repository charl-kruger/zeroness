{
  // edgelock Broker — deploy as its own Worker exposing the EdgelockBroker DO.
  "name": "edgelock-broker",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "EDGELOCK_BROKER", "class_name": "EdgelockBroker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EdgelockBroker"] }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "edgelock-snapshots" }]
  // Secrets referenced by resource bindings: add via `wrangler secret put <NAME>`,
  // then map them into env.SECRETS, or use Cloudflare Secrets Store bindings.
}
