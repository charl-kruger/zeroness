{
  "name": "@zeroness/broker",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charl-kruger/zeroness.git",
    "directory": "packages/broker"
  },
  "description": "zeroness Broker \u2014 the trust-root Durable Object: policy eval, per-request identity minting, capability resolution, audit.",
