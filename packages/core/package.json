{
  "name": "@zeroness/core",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charl-kruger/zeroness.git",
    "directory": "packages/core"
  },
  "description": "Zero-trust wrapper, network policy engine, capability handles, and signed command channel for Cloudflare Sandboxes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@zeroness/tls": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/charl-kruger/zeroness#readme",
  "bugs": "https://github.com/charl-kruger/zeroness/issues"
}
