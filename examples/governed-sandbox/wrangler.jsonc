{
  "name": "zeroness-sandbox-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "containers": [
    { "class_name": "Sandbox", "image": "./Dockerfile", "max_instances": 1, "instance_type": "standard" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "ZERONESS_BROKER", "class_name": "ZeronessBroker", "script_name": "zeroness-broker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  "vars": { "EGRESS_URL": "https://zeroness-egress.invsy.workers.dev" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
